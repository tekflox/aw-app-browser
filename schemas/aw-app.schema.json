{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aw-app.schema.json",
  "title": "aw-app.json manifest (v1)",
  "description": "Minimal structural validator for the Decoupled Apps Framework manifest (docs/knowledge_base/docs/architecture/decoupled-apps-framework.md, Decision 2). Not the framework's eventual canonical schema — a local stand-in until Phase 1 publishes schemas/aw-app.schema.json for real.",
  "type": "object",
  "required": ["manifest_version", "id", "name", "version", "tier", "runtime", "permissions", "contributes"],
  "properties": {
    "manifest_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "tier": { "enum": ["inprocess", "container"] },
    "runtime": {
      "type": "object",
      "properties": {
        "python": { "type": "string" },
        "entrypoint": { "type": "string" },
        "pip_requires": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(routes:register|db:own-tables|commands:install|service:manage|watchdog:tasks|notifications:send|containers:manage|config:extend:[a-z0-9-]+|net:outbound|fs:workspace-data|secrets:own|ui:code|ui:slots:[a-z0-9.:_-]+)$"
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "routes": { "type": "array" },
        "commands": { "type": "array" },
        "system_clis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "installer"],
            "properties": {
              "name": { "type": "string" },
              "installer": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "windows": { "type": "array" },
        "nav": { "type": "array" },
        "settings_panels": { "type": "array" },
        "frontend": { "type": "object" },
        "services": { "type": "array" },
        "containers": { "type": "array" },
        "extension_points": { "type": "array" },
        "extensions": { "type": "array" }
      }
    },
    "config_schema": {
      "type": "object",
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object" }
      }
    },
    "dependencies": { "type": "object" },
    "migrations": { "type": "object" }
  }
}
